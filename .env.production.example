# Variabili d'ambiente di PRODUZIONE (Laravel Cloud) — solo valori NON segreti.
#
# Si impostano nel pannello di Laravel Cloud, non nel repo. Questo file è il promemoria di cosa metterci;
# copialo in `.env.production` (ignorato da git) se vuoi che `npm run predeploy` controlli la configurazione.
#
# NON mettere qui (né in `.env.production`): GITHUB_TOKEN, APP_KEY, password, chiavi del bucket.
# Quelle stanno solo su Laravel Cloud (il predeploy blocca il deploy se le trova nel file).
#
# NON vanno impostate a mano, le inserisce Cloud collegando le risorse:
#   - database:  DB_CONNECTION, DB_HOST, DB_PORT, DB_DATABASE, DB_USERNAME, DB_PASSWORD, ...
#   - bucket:    FILESYSTEM_DISK, LARAVEL_CLOUD_DISK_CONFIG (il disco "uploads")

APP_NAME="Mirko Bechini Portfolio"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://mirkobechini.com
LOG_LEVEL=warning

# Il sito pubblico non ha login: la sessione sta in un cookie. Il database del piano Dev si sospende dopo
# 5 minuti, quindi sessioni e cache NON usano il database.
SESSION_DRIVER=cookie
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Il filesystem di Laravel Cloud non è persistente: le immagini caricate dal pannello vanno nel bucket
# (disco "uploads"). Con `public` o `local` andrebbero perse al deploy successivo.
UPLOADS_DISK=uploads
# I caricamenti temporanei di Livewire restano sul disco locale (con il bucket come disco predefinito
# proverebbero a caricare direttamente dal browser, e servirebbe la configurazione CORS del bucket).
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Sincronizzazione con GitHub. Il token (GITHUB_TOKEN) si imposta solo su Laravel Cloud.
GITHUB_USERNAME=mirkobechini
