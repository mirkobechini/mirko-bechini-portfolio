{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:serve": "concurrently \"npm run vite\" \"npm run laravel\"",
        "vite": "vite",
        "laravel": "php artisan serve",
        "build": "vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
        "predeploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/predeploy.ps1",
        "predeploy:sh": "bash scripts/predeploy.sh"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.8",
        "@vitejs/plugin-react": "^6.0.2",
        "@vitest/coverage-v8": "^5.0.5",
        "concurrently": "^10.0.6",
        "eslint": "^10.5.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.6.0",
        "identity-obj-proxy": "^3.0.0",
        "jsdom": "^30.1.3",
        "laravel-vite-plugin": "^3.1.0",
        "sharp": "^0.35.2",
        "vite": "^8.0.16",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "nes.css": "^2.3.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-router-dom": "^7.18.0"
    },
    "overrides": {
        "brace-expansion": ">=5.0.12"
    }
}
